#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
OpenAI-compatible chat/completions server backed by llama.cpp.
"""

import argparse
import json
import re
import time
import traceback
import uuid
from typing import Any, Dict, List, Optional, Tuple

import llama_cpp
import uvicorn
from fastapi import FastAPI, Request
from fastapi.responses import JSONResponse, StreamingResponse
from llama_cpp import Llama

app = FastAPI()

llm: Optional[Llama] = None
MODEL_ID = "local-llm"


@app.get("/health")
def health():
    return {
        "status": "ok",
        "model": MODEL_ID,
        "context": llm.n_ctx() if llm is not None else None,
    }


@app.get("/v1/models")
def list_models():
    return {
        "object": "list",
        "data": [
            {
                "id": MODEL_ID,
                "object": "model",
                "created": int(time.time()),
                "owned_by": "local",
            }
        ],
    }


def content_to_text(content: Any) -> str:
    if content is None:
        return ""

    if isinstance(content, str):
        return content

    if isinstance(content, list):
        pieces: List[str] = []

        for item in content:
            if isinstance(item, str):
                pieces.append(item)
                continue

            if isinstance(item, dict):
                item_type = item.get("type")

                if item_type in ("text", "input_text", "output_text"):
                    pieces.append(str(item.get("text", "")))
                else:
                    pieces.append(json.dumps(item, ensure_ascii=False))

                continue

            pieces.append(str(item))

        return "\n".join(pieces)

    if isinstance(content, dict):
        return json.dumps(content, ensure_ascii=False)

    return str(content)


def gemma_argument_value(value: Any) -> str:
    if isinstance(value, str):
        escaped = value.replace("\\", "\\\\").replace('"', '\\"')
        return f'<|"|>{escaped}<|"|>'

    return json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":"),
    )


def openai_tool_call_to_gemma(tool_call: Dict[str, Any]) -> str:
    function = tool_call.get("function") or {}

    name = str(function.get("name") or "unknown_tool")
    raw_arguments = function.get("arguments", "{}")

    if isinstance(raw_arguments, str):
        try:
            arguments = json.loads(raw_arguments)
        except Exception:
            arguments = {"input": raw_arguments}

    elif isinstance(raw_arguments, dict):
        arguments = raw_arguments

    else:
        arguments = {"input": raw_arguments}

    if not isinstance(arguments, dict):
        arguments = {"input": arguments}

    rendered_arguments = []

    for key, value in arguments.items():
        rendered_arguments.append(
            f"{key}:{gemma_argument_value(value)}"
        )

    argument_text = ",".join(rendered_arguments)

    return (
        "<|tool_call>"
        f"call:{name}"
        "{"
        f"{argument_text}"
        "}"
        "<tool_call|>"
    )


def normalize_messages_for_gemma(
    messages: List[Dict[str, Any]]
) -> List[Dict[str, str]]:
    normalized: List[Dict[str, str]] = []
    tool_names: Dict[str, str] = {}

    def append_message(role: str, content: Any):
        text = content_to_text(content)

        if (
            normalized
            and normalized[-1]["role"] == role
            and role == "user"
        ):
            previous = normalized[-1]["content"]

            if previous and text:
                normalized[-1]["content"] = previous + "\n\n" + text
            elif text:
                normalized[-1]["content"] = text

            return

        normalized.append(
            {
                "role": role,
                "content": text,
            }
        )

    for message in messages:
        role = message.get("role")
        content = message.get("content")

        if role == "assistant" and message.get("tool_calls"):
            pieces: List[str] = []

            if content:
                pieces.append(content_to_text(content))

            for tool_call in message["tool_calls"]:
                call_id = tool_call.get("id")
                function = tool_call.get("function") or {}
                tool_name = str(
                    function.get("name") or "unknown_tool"
                )

                if call_id:
                    tool_names[str(call_id)] = tool_name

                pieces.append(
                    openai_tool_call_to_gemma(tool_call)
                )

            append_message(
                "assistant",
                "\n".join(pieces),
            )

            continue

        if role in ("tool", "tool_result", "tool_results"):
            call_id = (
                message.get("tool_call_id")
                or message.get("toolCallId")
                or ""
            )

            tool_name = (
                message.get("name")
                or tool_names.get(str(call_id))
                or "tool"
            )

            result_text = content_to_text(content)

            rendered = f"[Tool result: {tool_name}"

            if call_id:
                rendered += f", id={call_id}"

            rendered += "]\n"
            rendered += result_text
            rendered += "\n[End tool result]"

            append_message("user", rendered)
            continue

        if role in ("system", "user", "assistant"):
            append_message(str(role), content)
            continue

        append_message(
            "user",
            f"[Message role={role}]\n{content_to_text(content)}",
        )

    return normalized


def extract_balanced_braces(
    text: str,
    start: int,
) -> Tuple[str, int]:
    if start >= len(text) or text[start] != "{":
        raise ValueError("expected '{'")

    depth = 0
    in_string = False
    escape = False
    gemma_quote = '<|"|>'

    i = start

    while i < len(text):
        if text.startswith(gemma_quote, i):
            in_string = not in_string
            i += len(gemma_quote)
            continue

        ch = text[i]

        if escape:
            escape = False
            i += 1
            continue

        if ch == "\\" and in_string:
            escape = True
            i += 1
            continue

        if ch == '"':
            in_string = not in_string
            i += 1
            continue

        if not in_string:
            if ch == "{":
                depth += 1

            elif ch == "}":
                depth -= 1

                if depth == 0:
                    return text[start + 1:i], i + 1

        i += 1

    raise ValueError("unclosed tool-call argument object")


def split_top_level(
    text: str,
    separator: str = ",",
) -> List[str]:
    pieces = []
    current = []

    brace_depth = 0
    bracket_depth = 0
    paren_depth = 0

    in_string = False
    escape = False
    gemma_quote = '<|"|>'

    i = 0

    while i < len(text):
        if text.startswith(gemma_quote, i):
            in_string = not in_string
            current.append(gemma_quote)
            i += len(gemma_quote)
            continue

        ch = text[i]

        if escape:
            current.append(ch)
            escape = False
            i += 1
            continue

        if ch == "\\" and in_string:
            current.append(ch)
            escape = True
            i += 1
            continue

        if ch == '"':
            in_string = not in_string
            current.append(ch)
            i += 1
            continue

        if not in_string:
            if ch == "{":
                brace_depth += 1
            elif ch == "}":
                brace_depth -= 1
            elif ch == "[":
                bracket_depth += 1
            elif ch == "]":
                bracket_depth -= 1
            elif ch == "(":
                paren_depth += 1
            elif ch == ")":
                paren_depth -= 1

            elif (
                ch == separator
                and brace_depth == 0
                and bracket_depth == 0
                and paren_depth == 0
            ):
                piece = "".join(current).strip()

                if piece:
                    pieces.append(piece)

                current = []
                i += 1
                continue

        current.append(ch)
        i += 1

    final_piece = "".join(current).strip()

    if final_piece:
        pieces.append(final_piece)

    return pieces


def split_key_value(text: str) -> Optional[Tuple[str, str]]:
    brace_depth = 0
    bracket_depth = 0

    in_string = False
    escape = False
    gemma_quote = '<|"|>'

    i = 0

    while i < len(text):
        if text.startswith(gemma_quote, i):
            in_string = not in_string
            i += len(gemma_quote)
            continue

        ch = text[i]

        if escape:
            escape = False
            i += 1
            continue

        if ch == "\\" and in_string:
            escape = True
            i += 1
            continue

        if ch == '"':
            in_string = not in_string
            i += 1
            continue

        if not in_string:
            if ch == "{":
                brace_depth += 1
            elif ch == "}":
                brace_depth -= 1
            elif ch == "[":
                bracket_depth += 1
            elif ch == "]":
                bracket_depth -= 1

            elif (
                ch == ":"
                and brace_depth == 0
                and bracket_depth == 0
            ):
                return (
                    text[:i].strip(),
                    text[i + 1:].strip(),
                )

        i += 1

    return None


def parse_gemma_value(raw: str) -> Any:
    raw = raw.strip()

    if (
        raw.startswith('<|"|>')
        and raw.endswith('<|"|>')
        and len(raw) >= 10
    ):
        value = raw[len('<|"|>'):-len('<|"|>')]

        return (
            value
            .replace('\\"', '"')
            .replace("\\\\", "\\")
        )

    try:
        return json.loads(raw)
    except Exception:
        pass

    lower = raw.lower()

    if lower == "true":
        return True

    if lower == "false":
        return False

    if lower in ("null", "none"):
        return None

    try:
        if "." in raw:
            return float(raw)

        return int(raw)

    except Exception:
        pass

    return raw.strip('"')


def parse_gemma_arguments(raw_args: str) -> Dict[str, Any]:
    raw_args = raw_args.strip()

    if not raw_args:
        return {}

    cleaned = raw_args.replace('<|"|>', '"')

    try:
        parsed = json.loads("{" + cleaned + "}")

        if isinstance(parsed, dict):
            return parsed

    except Exception:
        pass

    result: Dict[str, Any] = {}

    for piece in split_top_level(raw_args):
        pair = split_key_value(piece)

        if pair is None:
            continue

        key, raw_value = pair
        key = key.strip().strip('"')

        result[key] = parse_gemma_value(raw_value)

    if result:
        return result

    return {"input": raw_args}


def parse_gemma_tool_calls(
    content: Any,
) -> Optional[List[Dict[str, Any]]]:
    if not isinstance(content, str):
        return None

    marker = "<|tool_call>"

    if marker not in content:
        return None

    calls: List[Dict[str, Any]] = []
    position = 0

    while True:
        marker_position = content.find(marker, position)

        if marker_position < 0:
            break

        cursor = marker_position + len(marker)

        while cursor < len(content) and content[cursor].isspace():
            cursor += 1

        if content.startswith("call:", cursor):
            cursor += len("call:")

        name_match = re.match(
            r"[A-Za-z0-9_.\-]+",
            content[cursor:],
        )

        if not name_match:
            position = cursor + 1
            continue

        name = name_match.group(0)
        cursor += len(name)

        while cursor < len(content) and content[cursor].isspace():
            cursor += 1

        if cursor >= len(content) or content[cursor] != "{":
            position = cursor + 1
            continue

        try:
            raw_args, after_brace = extract_balanced_braces(
                content,
                cursor,
            )

        except Exception as exc:
            print(
                f"[tool-parser] failed extracting {name}: {exc}",
                flush=True,
            )

            position = cursor + 1
            continue

        try:
            arguments = parse_gemma_arguments(raw_args)

        except Exception as exc:
            print(
                f"[tool-parser] failed parsing {name}: {exc}",
                flush=True,
            )

            arguments = {"input": raw_args}

        calls.append(
            {
                "id": "call_" + uuid.uuid4().hex[:24],
                "type": "function",
                "function": {
                    "name": name,
                    "arguments": json.dumps(
                        arguments,
                        ensure_ascii=False,
                    ),
                },
            }
        )

        end_marker = content.find(
            "<tool_call|>",
            after_brace,
        )

        if end_marker >= 0:
            position = end_marker + len("<tool_call|>")
        else:
            position = after_brace

    return calls or None


def normalize_completion(
    result: Dict[str, Any]
) -> Tuple[Dict[str, Any], str]:
    choice = result["choices"][0]
    message = choice.get("message") or {}

    content = message.get("content")
    tool_calls = message.get("tool_calls")

    if not tool_calls and content:
        try:
            tool_calls = parse_gemma_tool_calls(content)
        except Exception:
            traceback.print_exc()
            tool_calls = None

    normalized_message: Dict[str, Any] = {
        "role": "assistant",
        "content": content,
    }

    if tool_calls:
        normalized_calls = []

        for tc in tool_calls:
            tc = dict(tc)

            if not tc.get("id"):
                tc["id"] = "call_" + uuid.uuid4().hex[:24]

            tc["type"] = "function"

            function = dict(tc.get("function") or {})
            arguments = function.get("arguments", "{}")

            if not isinstance(arguments, str):
                arguments = json.dumps(
                    arguments,
                    ensure_ascii=False,
                )

            function["arguments"] = arguments
            tc["function"] = function

            normalized_calls.append(tc)

        normalized_message["content"] = None
        normalized_message["tool_calls"] = normalized_calls

        finish_reason = "tool_calls"

    else:
        finish_reason = choice.get("finish_reason") or "stop"

    return normalized_message, finish_reason


def sse_line(data: Any) -> str:
    if data == "[DONE]":
        return "data: [DONE]\n\n"

    return (
        "data: "
        + json.dumps(data, ensure_ascii=False)
        + "\n\n"
    )


def stream_completed_response(
    completion_id: str,
    created: int,
    message: Dict[str, Any],
    finish_reason: str,
):
    yield sse_line(
        {
            "id": completion_id,
            "object": "chat.completion.chunk",
            "created": created,
            "model": MODEL_ID,
            "choices": [
                {
                    "index": 0,
                    "delta": {"role": "assistant"},
                    "finish_reason": None,
                }
            ],
        }
    )

    if message.get("tool_calls"):
        tool_deltas = []

        for index, tc in enumerate(message["tool_calls"]):
            tool_deltas.append(
                {
                    "index": index,
                    "id": tc.get("id"),
                    "type": "function",
                    "function": {
                        "name": tc.get(
                            "function",
                            {},
                        ).get("name"),
                        "arguments": tc.get(
                            "function",
                            {},
                        ).get(
                            "arguments",
                            "{}",
                        ),
                    },
                }
            )

        yield sse_line(
            {
                "id": completion_id,
                "object": "chat.completion.chunk",
                "created": created,
                "model": MODEL_ID,
                "choices": [
                    {
                        "index": 0,
                        "delta": {
                            "tool_calls": tool_deltas
                        },
                        "finish_reason": None,
                    }
                ],
            }
        )

    elif message.get("content") is not None:
        yield sse_line(
            {
                "id": completion_id,
                "object": "chat.completion.chunk",
                "created": created,
                "model": MODEL_ID,
                "choices": [
                    {
                        "index": 0,
                        "delta": {
                            "content": message.get(
                                "content",
                                "",
                            )
                        },
                        "finish_reason": None,
                    }
                ],
            }
        )

    yield sse_line(
        {
            "id": completion_id,
            "object": "chat.completion.chunk",
            "created": created,
            "model": MODEL_ID,
            "choices": [
                {
                    "index": 0,
                    "delta": {},
                    "finish_reason": finish_reason,
                }
            ],
        }
    )

    yield sse_line("[DONE]")


@app.post("/v1/chat/completions")
async def chat_completions(request: Request):
    global llm

    body = await request.json()

    original_messages = body.get("messages", [])

    messages = normalize_messages_for_gemma(
        original_messages
    )

    requested_stream = bool(
        body.get("stream", False)
    )

    kwargs: Dict[str, Any] = {
        "messages": messages,
        "max_tokens": body.get(
            "max_tokens",
            4096,
        ),
        "temperature": body.get(
            "temperature",
            0.2,
        ),
        "top_p": body.get(
            "top_p",
            0.95,
        ),
        "stream": False,
    }

    if body.get("stop") is not None:
        kwargs["stop"] = body["stop"]

    if body.get("tools") is not None:
        kwargs["tools"] = body["tools"]

    if body.get("tool_choice") is not None:
        kwargs["tool_choice"] = body["tool_choice"]

    try:
        if llm is None:
            raise RuntimeError("Model is not loaded")

        result = llm.create_chat_completion(**kwargs)

    except Exception as exc:
        print(
            "\n=== LLAMA CHAT COMPLETION ERROR ===",
            flush=True,
        )

        print(
            "Exception:",
            repr(exc),
            flush=True,
        )

        print(
            "\nNormalized Gemma messages:",
            flush=True,
        )

        try:
            print(
                json.dumps(
                    messages,
                    indent=2,
                    ensure_ascii=False,
                ),
                flush=True,
            )
        except Exception:
            pass

        traceback.print_exc()

        return JSONResponse(
            status_code=500,
            content={
                "error": {
                    "message": str(exc),
                    "type": type(exc).__name__,
                    "code": "local_llama_error",
                }
            },
        )

    message, finish_reason = normalize_completion(result)

    completion_id = "chatcmpl-" + uuid.uuid4().hex
    created = int(time.time())

    if requested_stream:
        return StreamingResponse(
            stream_completed_response(
                completion_id,
                created,
                message,
                finish_reason,
            ),
            media_type="text/event-stream",
            headers={
                "Cache-Control": "no-cache",
                "Connection": "keep-alive",
                "X-Accel-Buffering": "no",
            },
        )

    return {
        "id": completion_id,
        "object": "chat.completion",
        "created": created,
        "model": MODEL_ID,
        "choices": [
            {
                "index": 0,
                "message": message,
                "finish_reason": finish_reason,
            }
        ],
        "usage": result.get("usage", {}),
    }


@app.post("/v1/completions")
async def completions(request: Request):
    global llm

    body = await request.json()
    prompt = body.get("prompt", "")

    if isinstance(prompt, list):
        prompt = "\n".join(str(x) for x in prompt)

    try:
        if llm is None:
            raise RuntimeError("Model is not loaded")

        out = llm.create_chat_completion(
            messages=[
                {
                    "role": "user",
                    "content": str(prompt),
                }
            ],
            max_tokens=body.get(
                "max_tokens",
                256,
            ),
            temperature=body.get(
                "temperature",
                0.2,
            ),
            top_p=body.get(
                "top_p",
                0.95,
            ),
            stop=body.get("stop") or None,
            stream=False,
        )

    except Exception as exc:
        traceback.print_exc()

        return JSONResponse(
            status_code=500,
            content={
                "error": {
                    "message": str(exc),
                    "type": type(exc).__name__,
                    "code": "local_llama_error",
                }
            },
        )

    choice = out["choices"][0]

    text = (
        choice.get(
            "message",
            {},
        ).get("content")
        or ""
    )

    return {
        "id": "cmpl-" + uuid.uuid4().hex,
        "object": "text_completion",
        "created": int(time.time()),
        "model": MODEL_ID,
        "choices": [
            {
                "index": 0,
                "text": text,
                "finish_reason": (
                    choice.get("finish_reason")
                    or "stop"
                ),
            }
        ],
        "usage": out.get("usage", {}),
    }


@app.exception_handler(Exception)
async def global_exception_handler(
    request: Request,
    exc: Exception,
):
    traceback.print_exc()

    return JSONResponse(
        status_code=500,
        content={
            "error": {
                "message": str(exc),
                "type": type(exc).__name__,
                "code": "internal_server_error",
            }
        },
    )


def main():
    global llm
    global MODEL_ID

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--model",
        required=True,
    )
    parser.add_argument(
        "--host",
        default="0.0.0.0",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=8091,
    )
    parser.add_argument(
        "--n-ctx",
        type=int,
        default=8192,
    )
    parser.add_argument(
        "--n-gpu-layers",
        type=int,
        default=-1,
    )
    parser.add_argument(
        "--model-id",
        default=None,
    )
    parser.add_argument(
        "--single-gpu",
        action="store_true",
    )

    args = parser.parse_args()

    if args.model_id:
        MODEL_ID = args.model_id

    print(
        "Loading model:",
        args.model,
        flush=True,
    )

    print(
        "Requested context:",
        args.n_ctx,
        flush=True,
    )

    if args.single_gpu:
        llm = Llama(
            model_path=args.model,
            n_ctx=args.n_ctx,
            n_gpu_layers=args.n_gpu_layers,
            flash_attn=True,
            offload_kqv=True,
            verbose=False,
        )

    else:
        llm = Llama(
            model_path=args.model,
            n_ctx=args.n_ctx,
            n_gpu_layers=args.n_gpu_layers,
            split_mode=llama_cpp.LLAMA_SPLIT_MODE_LAYER,
            tensor_split=[0.5, 0.5],
            main_gpu=0,
            flash_attn=True,
            offload_kqv=True,
            verbose=False,
        )

    print("MODEL READY", flush=True)
    print("MODEL ID:", MODEL_ID, flush=True)
    print("ACTUAL CONTEXT:", llm.n_ctx(), flush=True)

    uvicorn.run(
        app,
        host=args.host,
        port=args.port,
    )


if __name__ == "__main__":
    main()
